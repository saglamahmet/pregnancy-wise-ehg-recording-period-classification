   "cell_type": "code",
   "execution_count": null,
   "id": "7d9ac235",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# ============================================================\n",
    "# CELL 7 — Yardımcı fonksiyonlar\n",
    "# ============================================================\n",
    "\n",
    "def set_run_seed(run_name):\n",
    "    run_offset = (\n",
    "        zlib.crc32(\n",
    "            run_name.encode(\"utf-8\")\n",
    "        )\n",
    "        %\n",
    "        100000\n",
    "    )\n",
    "\n",
    "    run_seed = int(\n",
    "        RANDOM_STATE\n",
    "        +\n",
    "        run_offset\n",
    "    )\n",
    "\n",
    "    random.seed(\n",
    "        run_seed\n",
    "    )\n",
    "\n",
    "    np.random.seed(\n",
    "        run_seed\n",
    "    )\n",
    "\n",
    "    tf.random.set_seed(\n",
    "        run_seed\n",
    "    )\n",
    "\n",
    "    return run_seed\n",
    "\n",
    "\n",
    "def record_indices_to_segment_indices(\n",
    "    record_indices\n",
    "):\n",
    "    selected_records = set(\n",
    "        record_df.iloc[\n",
    "            record_indices\n",
    "        ][\"record_name\"].astype(str)\n",
    "    )\n",
    "\n",
    "    mask = segment_df[\n",
    "        \"record_name\"\n",
    "    ].isin(\n",
    "        selected_records\n",
    "    )\n",
    "\n",
    "    return segment_df.loc[\n",
    "        mask,\n",
    "        \"segment_index\"\n",
    "    ].astype(int).values\n",
    "\n",
    "\n",
    "def aggregate_segment_predictions(\n",
    "    df\n",
    "):\n",
    "    return (\n",
    "        df\n",
    "        .groupby(\n",
    "            \"record_name\",\n",
    "            as_index=False\n",
    "        )\n",
    "        .agg(\n",
    "            prob_early_raw=(\n",
    "                \"prob_early_raw\",\n",
    "                \"mean\"\n",
    "            ),\n",
    "            label_num=(\n",
    "                \"label_num\",\n",
    "                \"first\"\n",
    "            ),\n",
    "            label_text=(\n",
    "                \"label_text\",\n",
    "                \"first\"\n",
    "            ),\n",
    "            pregnancy_id=(\n",
    "                \"pregnancy_id\",\n",
    "                \"first\"\n",
    "            ),\n",
    "            n_segments=(\n",
    "                \"segment_index\",\n",
    "                \"count\"\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "def calculate_binary_metrics(\n",
    "    y_true,\n",
    "    y_prob,\n",
    "    y_pred\n",
    "):\n",
    "    y_true = np.asarray(\n",
    "        y_true,\n",
    "        dtype=int\n",
    "    )\n",
    "\n",
    "    y_prob = np.asarray(\n",
    "        y_prob,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y_pred = np.asarray(\n",
    "        y_pred,\n",
    "        dtype=int\n",
    "    )\n",
    "\n",
    "    tn, fp, fn, tp = confusion_matrix(\n",
    "        y_true,\n",
    "        y_pred,\n",
    "        labels=[0, 1]\n",
    "    ).ravel()\n",
    "\n",
    "    sensitivity = (\n",
    "        tp / (tp + fn)\n",
    "        if (tp + fn) > 0\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "    specificity = (\n",
    "        tn / (tn + fp)\n",
    "        if (tn + fp) > 0\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "    ba = (\n",
    "        (sensitivity + specificity) / 2.0\n",
    "        if (\n",
    "            np.isfinite(sensitivity)\n",
    "            and\n",
    "            np.isfinite(specificity)\n",
    "        )\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "    auc_value = (\n",
    "        roc_auc_score(\n",
    "            y_true,\n",
    "            y_prob\n",
    "        )\n",
    "        if len(np.unique(y_true)) == 2\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"accuracy\": accuracy_score(\n",
    "            y_true,\n",
    "            y_pred\n",
    "        ),\n",
    "        \"precision\": precision_score(\n",
    "            y_true,\n",
    "            y_pred,\n",
    "            zero_division=0\n",
    "        ),\n",
    "        \"sensitivity\": sensitivity,\n",
    "        \"specificity\": specificity,\n",
    "        \"f1\": f1_score(\n",
    "            y_true,\n",
    "            y_pred,\n",
    "            zero_division=0\n",
    "        ),\n",
    "        \"balanced_accuracy\": ba,\n",
    "        \"auc\": auc_value,\n",
    "        \"brier\": brier_score_loss(\n",
    "            y_true,\n",
    "            np.clip(y_prob, 0, 1)\n",
    "        ),\n",
    "        \"tn\": int(tn),\n",
    "        \"fp\": int(fp),\n",
    "        \"fn\": int(fn),\n",
    "        \"tp\": int(tp),\n",
    "    }\n",
    "\n",
    "\n",
    "def select_robust_threshold(\n",
    "    y_true,\n",
    "    y_prob\n",
    "):\n",
    "    rows = []\n",
    "\n",
    "    thresholds = np.arange(\n",
    "        THRESHOLD_MIN,\n",
    "        THRESHOLD_MAX\n",
    "        +\n",
    "        THRESHOLD_STEP / 2,\n",
    "        THRESHOLD_STEP\n",
    "    )\n",
    "\n",
    "    for threshold in thresholds:\n",
    "        y_pred = (\n",
    "            np.asarray(y_prob)\n",
    "            >=\n",
    "            threshold\n",
    "        ).astype(int)\n",
    "\n",
    "        metrics = calculate_binary_metrics(\n",
    "            y_true,\n",
    "            y_prob,\n",
    "            y_pred\n",
    "        )\n",
    "\n",
    "        rows.append({\n",
    "            \"threshold\": float(\n",
    "                threshold\n",
    "            ),\n",
    "            **metrics,\n",
    "            \"class_balance_gap\": abs(\n",
    "                metrics[\"sensitivity\"]\n",
    "                -\n",
    "                metrics[\"specificity\"]\n",
    "            ),\n",
    "            \"distance_to_half\": abs(\n",
    "                float(threshold)\n",
    "                -\n",
    "                0.5\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    threshold_df = pd.DataFrame(\n",
    "        rows\n",
    "    )\n",
    "\n",
    "    best_ba = threshold_df[\n",
    "        \"balanced_accuracy\"\n",
    "    ].max()\n",
    "\n",
    "    candidates = threshold_df[\n",
    "        threshold_df[\n",
    "            \"balanced_accuracy\"\n",
    "        ]\n",
    "        >=\n",
    "        best_ba\n",
    "        -\n",
    "        ROBUST_BA_TOLERANCE\n",
    "    ].copy()\n",
    "\n",
    "    selected = (\n",
    "        candidates\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"class_balance_gap\",\n",
    "                \"distance_to_half\",\n",
    "                \"f1\",\n",
    "                \"accuracy\"\n",
    "            ],\n",
    "            ascending=[\n",
    "                True,\n",
    "                True,\n",
    "                False,\n",
    "                False\n",
    "            ]\n",
    "        )\n",
    "        .iloc[0]\n",
    "        .to_dict()\n",
    "    )\n",
    "\n",
    "    return selected, threshold_df\n",
    "\n",
    "\n",
    "def logit_transform(\n",
    "    probabilities,\n",
    "    epsilon=1e-6\n",
    "):\n",
    "    probabilities = np.clip(\n",
    "        np.asarray(\n",
    "            probabilities,\n",
    "            dtype=float\n",
    "        ),\n",
    "        epsilon,\n",
    "        1.0 - epsilon\n",
    "    )\n",
    "\n",
    "    return np.log(\n",
    "        probabilities\n",
    "        /\n",
    "        (1.0 - probabilities)\n",
    "    ).reshape(-1, 1)\n",
    "\n",
    "\n",
    "def fit_positive_platt(\n",
    "    y_true,\n",
    "    raw_prob\n",
    "):\n",
    "    calibrator = LogisticRegression(\n",
    "        C=PLATT_C,\n",
    "        solver=\"lbfgs\",\n",
    "        max_iter=2000,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "\n",
    "    calibrator.fit(\n",
    "        logit_transform(\n",
    "            raw_prob\n",
    "        ),\n",
    "        np.asarray(\n",
    "            y_true,\n",
    "            dtype=int\n",
    "        )\n",
    "    )\n",
    "\n",
    "    slope = float(\n",
    "        calibrator.coef_[\n",
    "            0, 0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    intercept = float(\n",
    "        calibrator.intercept_[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    if slope <= 0:\n",
    "        return (\n",
    "            None,\n",
    "            slope,\n",
    "            intercept\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        calibrator,\n",
    "        slope,\n",
    "        intercept\n",
    "    )\n",
    "\n",
    "\n",
    "def apply_platt(\n",
    "    calibrator,\n",
    "    raw_prob\n",
    "):\n",
    "    if calibrator is None:\n",
    "        return np.asarray(\n",
    "            raw_prob,\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    return calibrator.predict_proba(\n",
    "        logit_transform(\n",
    "            raw_prob\n",
    "        )\n",
    "    )[:, 1]\n",
    "\n",
    "\n",
    "def merge_rep_record_predictions(\n",
    "    pred_dict\n",
    "):\n",
    "    merged = None\n",
    "\n",
    "    for rep in REPRESENTATIONS:\n",
    "        temp = pred_dict[\n",
    "            rep\n",
    "        ][\n",
    "            [\n",
    "                \"record_name\",\n",
    "                \"pregnancy_id\",\n",
    "                \"label_num\",\n",
    "                \"prob_early_raw\"\n",
    "            ]\n",
    "        ].copy()\n",
    "\n",
    "        temp = temp.rename(\n",
    "            columns={\n",
    "                \"prob_early_raw\":\n",
    "                f\"prob_{rep}\"\n",
    "            }\n",
    "        )\n",
    "\n",
    "        if merged is None:\n",
    "            merged = temp\n",
    "        else:\n",
    "            merged = merged.merge(\n",
    "                temp[\n",
    "                    [\n",
    "                        \"record_name\",\n",
    "                        f\"prob_{rep}\"\n",
    "                    ]\n",
    "                ],\n",
    "                on=\"record_name\",\n",
    "                how=\"inner\"\n",
    "            )\n",
    "\n",
    "    return merged\n",
    "\n",
    "\n",
    "def generate_weight_grid():\n",
    "    step_units = int(\n",
    "        round(\n",
    "            1.0 / WEIGHT_STEP\n",
    "        )\n",
    "    )\n",
    "\n",
    "    min_units = int(\n",
    "        round(\n",
    "            MIN_WEIGHT / WEIGHT_STEP\n",
    "        )\n",
    "    )\n",
    "\n",
    "    max_units = int(\n",
    "        round(\n",
    "            MAX_WEIGHT / WEIGHT_STEP\n",
    "        )\n",
    "    )\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for units in product(\n",
    "        range(\n",
    "            min_units,\n",
    "            max_units + 1\n",
    "        ),\n",
    "        repeat=4\n",
    "    ):\n",
    "        if sum(units) != step_units:\n",
    "            continue\n",
    "\n",
    "        weights = (\n",
    "            np.asarray(\n",
    "                units,\n",
    "                dtype=float\n",
    "            )\n",
    "            *\n",
    "            WEIGHT_STEP\n",
    "        )\n",
    "\n",
    "        rows.append({\n",
    "            \"w_RGB\": weights[0],\n",
    "            \"w_S1\": weights[1],\n",
    "            \"w_S2\": weights[2],\n",
    "            \"w_S3\": weights[3],\n",
    "            \"weight_l2_from_equal\": float(\n",
    "                np.sum(\n",
    "                    (weights - 0.25) ** 2\n",
    "                )\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(rows)\n",
    "        .drop_duplicates()\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "WEIGHT_GRID = generate_weight_grid()\n",
    "\n",
    "print(\n",
    "    \"Weight candidates:\",\n",
    "    len(WEIGHT_GRID)\n",
    ")\n"
   ]
  },
