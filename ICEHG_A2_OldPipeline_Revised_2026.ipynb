   "source": [
    "\n",
    "# ============================================================\n",
    "# CELL 6 — A2 CNN–SE–Transformer mimarisi\n",
    "# ============================================================\n",
    "\n",
    "@keras.utils.register_keras_serializable(\n",
    "    package=\"ICEHG_A2\"\n",
    ")\n",
    "class AddPositionEmbedding(\n",
    "    layers.Layer\n",
    "):\n",
    "    def build(self, input_shape):\n",
    "        sequence_length = int(\n",
    "            input_shape[1]\n",
    "        )\n",
    "\n",
    "        embedding_dimension = int(\n",
    "            input_shape[2]\n",
    "        )\n",
    "\n",
    "        self.position_embedding = (\n",
    "            self.add_weight(\n",
    "                name=\"position_embedding\",\n",
    "                shape=(\n",
    "                    sequence_length,\n",
    "                    embedding_dimension\n",
    "                ),\n",
    "                initializer=\"random_normal\",\n",
    "                trainable=True\n",
    "            )\n",
    "        )\n",
    "\n",
    "        super().build(\n",
    "            input_shape\n",
    "        )\n",
    "\n",
    "    def call(self, inputs):\n",
    "        return (\n",
    "            inputs\n",
    "            +\n",
    "            self.position_embedding[\n",
    "                tf.newaxis,\n",
    "                ...\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "def se_block(\n",
    "    x,\n",
    "    reduction=8,\n",
    "    name_prefix=\"se\"\n",
    "):\n",
    "    filters = int(\n",
    "        x.shape[-1]\n",
    "    )\n",
    "\n",
    "    se = layers.GlobalAveragePooling2D(\n",
    "        name=f\"{name_prefix}_gap\"\n",
    "    )(x)\n",
    "\n",
    "    se = layers.Dense(\n",
    "        max(\n",
    "            filters // reduction,\n",
    "            1\n",
    "        ),\n",
    "        activation=\"relu\",\n",
    "        name=f\"{name_prefix}_dense_1\"\n",
    "    )(se)\n",
    "\n",
    "    se = layers.Dense(\n",
    "        filters,\n",
    "        activation=\"sigmoid\",\n",
    "        name=f\"{name_prefix}_dense_2\"\n",
    "    )(se)\n",
    "\n",
    "    se = layers.Reshape(\n",
    "        (\n",
    "            1,\n",
    "            1,\n",
    "            filters\n",
    "        ),\n",
    "        name=f\"{name_prefix}_reshape\"\n",
    "    )(se)\n",
    "\n",
    "    return layers.Multiply(\n",
    "        name=f\"{name_prefix}_scale\"\n",
    "    )([x, se])\n",
    "\n",
    "\n",
    "def residual_cnn_block(\n",
    "    x,\n",
    "    filters,\n",
    "    block_index\n",
    "):\n",
    "    prefix = (\n",
    "        f\"residual_block_{block_index}\"\n",
    "    )\n",
    "\n",
    "    shortcut = x\n",
    "\n",
    "    x = layers.Conv2D(\n",
    "        filters,\n",
    "        kernel_size=3,\n",
    "        padding=\"same\",\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=f\"{prefix}_conv_1\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.BatchNormalization(\n",
    "        name=f\"{prefix}_bn_1\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Activation(\n",
    "        \"relu\",\n",
    "        name=f\"{prefix}_relu_1\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Conv2D(\n",
    "        filters,\n",
    "        kernel_size=3,\n",
    "        padding=\"same\",\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=f\"{prefix}_conv_2\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.BatchNormalization(\n",
    "        name=f\"{prefix}_bn_2\"\n",
    "    )(x)\n",
    "\n",
    "    x = se_block(\n",
    "        x,\n",
    "        reduction=8,\n",
    "        name_prefix=f\"{prefix}_se\"\n",
    "    )\n",
    "\n",
    "    if int(\n",
    "        shortcut.shape[-1]\n",
    "    ) != filters:\n",
    "        shortcut = layers.Conv2D(\n",
    "            filters,\n",
    "            kernel_size=1,\n",
    "            padding=\"same\",\n",
    "            kernel_regularizer=regularizers.l2(\n",
    "                L2_WEIGHT\n",
    "            ),\n",
    "            name=f\"{prefix}_shortcut_conv\"\n",
    "        )(shortcut)\n",
    "\n",
    "        shortcut = layers.BatchNormalization(\n",
    "            name=f\"{prefix}_shortcut_bn\"\n",
    "        )(shortcut)\n",
    "\n",
    "    x = layers.Add(\n",
    "        name=f\"{prefix}_add\"\n",
    "    )([x, shortcut])\n",
    "\n",
    "    x = layers.Activation(\n",
    "        \"relu\",\n",
    "        name=f\"{prefix}_relu_out\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.MaxPooling2D(\n",
    "        pool_size=(2, 2),\n",
    "        name=f\"{prefix}_pool\"\n",
    "    )(x)\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "def cnn_backbone(inputs):\n",
    "    x = residual_cnn_block(\n",
    "        inputs, 32, 1\n",
    "    )\n",
    "\n",
    "    x = residual_cnn_block(\n",
    "        x, 64, 2\n",
    "    )\n",
    "\n",
    "    x = residual_cnn_block(\n",
    "        x, 128, 3\n",
    "    )\n",
    "\n",
    "    x = residual_cnn_block(\n",
    "        x, 256, 4\n",
    "    )\n",
    "\n",
    "    # A2: 14×14 -> 7×7\n",
    "    x = layers.MaxPooling2D(\n",
    "        pool_size=(2, 2),\n",
    "        name=\"backbone_final_pool\"\n",
    "    )(x)\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "def transformer_encoder_block(\n",
    "    x,\n",
    "    block_index\n",
    "):\n",
    "    prefix = (\n",
    "        f\"transformer_block_{block_index}\"\n",
    "    )\n",
    "\n",
    "    attention_output = (\n",
    "        layers.MultiHeadAttention(\n",
    "            num_heads=NUM_HEADS,\n",
    "            key_dim=EMBED_DIM // NUM_HEADS,\n",
    "            dropout=DROPOUT,\n",
    "            name=f\"{prefix}_mha\"\n",
    "        )(x, x)\n",
    "    )\n",
    "\n",
    "    x = layers.Add(\n",
    "        name=f\"{prefix}_attention_add\"\n",
    "    )([x, attention_output])\n",
    "\n",
    "    x = layers.LayerNormalization(\n",
    "        epsilon=1e-6,\n",
    "        name=f\"{prefix}_attention_norm\"\n",
    "    )(x)\n",
    "\n",
    "    ffn = layers.Dense(\n",
    "        FF_DIM,\n",
    "        activation=\"relu\",\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=f\"{prefix}_ffn_1\"\n",
    "    )(x)\n",
    "\n",
    "    ffn = layers.Dropout(\n",
    "        DROPOUT,\n",
    "        name=f\"{prefix}_ffn_dropout\"\n",
    "    )(ffn)\n",
    "\n",
    "    ffn = layers.Dense(\n",
    "        EMBED_DIM,\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=f\"{prefix}_ffn_2\"\n",
    "    )(ffn)\n",
    "\n",
    "    x = layers.Add(\n",
    "        name=f\"{prefix}_ffn_add\"\n",
    "    )([x, ffn])\n",
    "\n",
    "    x = layers.LayerNormalization(\n",
    "        epsilon=1e-6,\n",
    "        name=f\"{prefix}_ffn_norm\"\n",
    "    )(x)\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "def build_a2_cnn_transformer(\n",
    "    representation\n",
    "):\n",
    "    channels = (\n",
    "        3\n",
    "        if representation == \"RGB\"\n",
    "        else 1\n",
    "    )\n",
    "\n",
    "    inputs = layers.Input(\n",
    "        shape=(\n",
    "            IMAGE_SIZE,\n",
    "            IMAGE_SIZE,\n",
    "            channels\n",
    "        ),\n",
    "        name=f\"{representation}_scalogram\"\n",
    "    )\n",
    "\n",
    "    x = cnn_backbone(\n",
    "        inputs\n",
    "    )\n",
    "\n",
    "    x = layers.Conv2D(\n",
    "        EMBED_DIM,\n",
    "        kernel_size=1,\n",
    "        padding=\"same\",\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=\"token_projection\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Reshape(\n",
    "        (49, EMBED_DIM),\n",
    "        name=\"cnn_tokens\"\n",
    "    )(x)\n",
    "\n",
    "    x = AddPositionEmbedding(\n",
    "        name=\"position_embedding\"\n",
    "    )(x)\n",
    "\n",
    "    for block_index in range(\n",
    "        1,\n",
    "        NUM_TRANSFORMER_BLOCKS + 1\n",
    "    ):\n",
    "        x = transformer_encoder_block(\n",
    "            x,\n",
    "            block_index\n",
    "        )\n",
    "\n",
    "    x = layers.GlobalAveragePooling1D(\n",
    "        name=\"token_gap\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Dense(\n",
    "        128,\n",
    "        activation=\"relu\",\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=\"head_dense_128\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Dropout(\n",
    "        DROPOUT,\n",
    "        name=\"head_dropout_128\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Dense(\n",
    "        64,\n",
    "        activation=\"relu\",\n",
    "        kernel_regularizer=regularizers.l2(\n",
    "            L2_WEIGHT\n",
    "        ),\n",
    "        name=\"head_dense_64\"\n",
    "    )(x)\n",
    "\n",
    "    x = layers.Dropout(\n",
    "        DROPOUT,\n",
    "        name=\"head_dropout_64\"\n",
    "    )(x)\n",
    "\n",
    "    outputs = layers.Dense(\n",
    "        1,\n",
    "        activation=\"sigmoid\",\n",
    "        dtype=\"float32\",\n",
    "        name=\"probability\"\n",
    "    )(x)\n",
    "\n",
    "    model = models.Model(\n",
    "        inputs,\n",
    "        outputs,\n",
    "        name=f\"A2_CNN_Transformer_{representation}\"\n",
    "    )\n",
    "\n",
    "    model.compile(\n",
    "        optimizer=keras.optimizers.Adam(\n",
    "            learning_rate=LEARNING_RATE\n",
    "        ),\n",
    "        loss=\"binary_crossentropy\",\n",
    "        metrics=[\n",
    "            keras.metrics.AUC(\n",
    "                name=\"auc\"\n",
    "            )\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    return model\n",
    "\n",
    "\n",
    "for rep in REPRESENTATIONS:\n",
    "    K.clear_session()\n",
    "\n",
    "    m = build_a2_cnn_transformer(\n",
    "        rep\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        rep,\n",
    "        \"params:\",\n",
    "        f\"{m.count_params():,}\"\n",
    "    )\n",
    "\n",
    "    del m\n",
    "\n",
    "K.clear_session()\n",
    "gc.collect()\n"
   ]
