    "\n",
    "# ============================================================\n",
    "# CELL 5 — Generic A2 scalogram Sequence\n",
    "# Eski A2 davranışı: stored scalogram / 255.0\n",
    "# ============================================================\n",
    "\n",
    "labels_all = (\n",
    "    segment_df[\"label_num\"]\n",
    "    .astype(np.float32)\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "class A2ScalogramSequence(\n",
    "    keras.utils.Sequence\n",
    "):\n",
    "    def __init__(\n",
    "        self,\n",
    "        representation,\n",
    "        segment_indices,\n",
    "        labels=labels_all,\n",
    "        batch_size=BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "    ):\n",
    "        super().__init__()\n",
    "\n",
    "        self.representation = representation\n",
    "\n",
    "        self.segment_indices = np.asarray(\n",
    "            segment_indices,\n",
    "            dtype=int\n",
    "        ).copy()\n",
    "\n",
    "        self.labels = np.asarray(\n",
    "            labels,\n",
    "            dtype=np.float32\n",
    "        )\n",
    "\n",
    "        self.batch_size = int(\n",
    "            batch_size\n",
    "        )\n",
    "\n",
    "        self.shuffle = bool(\n",
    "            shuffle\n",
    "        )\n",
    "\n",
    "        self.X = np.load(\n",
    "            SCALOGRAM_PATHS[\n",
    "                representation\n",
    "            ],\n",
    "            mmap_mode=\"r\"\n",
    "        )\n",
    "\n",
    "        self.on_epoch_end()\n",
    "\n",
    "    def __len__(self):\n",
    "        return int(\n",
    "            np.ceil(\n",
    "                len(self.segment_indices)\n",
    "                /\n",
    "                self.batch_size\n",
    "            )\n",
    "        )\n",
    "\n",
    "    def __getitem__(self, batch_index):\n",
    "        batch_ids = self.segment_indices[\n",
    "            batch_index * self.batch_size:\n",
    "            (batch_index + 1) * self.batch_size\n",
    "        ]\n",
    "\n",
    "        X_batch = self.X[\n",
    "            batch_ids\n",
    "        ].astype(np.float32)\n",
    "\n",
    "        # Eski A2 generator ile aynı scaling.\n",
    "        X_batch = X_batch / 255.0\n",
    "\n",
    "        if X_batch.ndim == 3:\n",
    "            X_batch = X_batch[..., np.newaxis]\n",
    "\n",
    "        y_batch = self.labels[\n",
    "            batch_ids\n",
    "        ].astype(np.float32)\n",
    "\n",
    "        return X_batch, y_batch\n",
    "\n",
    "    def on_epoch_end(self):\n",
    "        if self.shuffle:\n",
    "            np.random.shuffle(\n",
    "                self.segment_indices\n",
    "            )\n",
    "\n",
    "print(\"A2ScalogramSequence hazır.\")\n"
   ]
  },
