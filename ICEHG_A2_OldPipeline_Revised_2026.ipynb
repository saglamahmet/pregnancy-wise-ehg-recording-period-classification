    "\n",
    "# ============================================================\n",
    "# CELL 12 — Pregnancy-wise cluster bootstrap\n",
    "# ============================================================\n",
    "\n",
    "def cluster_bootstrap_auc(\n",
    "    dataframe,\n",
    "    score_col,\n",
    "    n_iterations=5000,\n",
    "    seed=942\n",
    "):\n",
    "    pregnancy_ids = dataframe[\n",
    "        \"pregnancy_id\"\n",
    "    ].astype(str).to_numpy()\n",
    "\n",
    "    y_true = dataframe[\n",
    "        \"label_num\"\n",
    "    ].astype(int).to_numpy()\n",
    "\n",
    "    scores = dataframe[\n",
    "        score_col\n",
    "    ].astype(float).to_numpy()\n",
    "\n",
    "    unique_preg = pd.unique(\n",
    "        pregnancy_ids\n",
    "    )\n",
    "\n",
    "    rng = np.random.default_rng(\n",
    "        seed\n",
    "    )\n",
    "\n",
    "    values = []\n",
    "\n",
    "    while len(values) < n_iterations:\n",
    "        sampled = rng.choice(\n",
    "            unique_preg,\n",
    "            size=len(unique_preg),\n",
    "            replace=True\n",
    "        )\n",
    "\n",
    "        blocks = [\n",
    "            np.where(\n",
    "                pregnancy_ids == pid\n",
    "            )[0]\n",
    "            for pid in sampled\n",
    "        ]\n",
    "\n",
    "        idx = np.concatenate(\n",
    "            blocks\n",
    "        )\n",
    "\n",
    "        if np.unique(\n",
    "            y_true[idx]\n",
    "        ).size < 2:\n",
    "            continue\n",
    "\n",
    "        values.append(\n",
    "            roc_auc_score(\n",
    "                y_true[idx],\n",
    "                scores[idx]\n",
    "            )\n",
    "        )\n",
    "\n",
    "    values = np.asarray(\n",
    "        values,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"estimate\": roc_auc_score(\n",
    "            y_true,\n",
    "            scores\n",
    "        ),\n",
    "        \"ci_lower_95\": float(\n",
    "            np.quantile(\n",
    "                values,\n",
    "                0.025\n",
    "            )\n",
    "        ),\n",
    "        \"ci_upper_95\": float(\n",
    "            np.quantile(\n",
    "                values,\n",
    "                0.975\n",
    "            )\n",
    "        ),\n",
    "        \"n_bootstrap\": len(\n",
    "            values\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "bootstrap_rows = []\n",
    "\n",
    "for label, col in [\n",
    "    (\n",
    "        \"Primary weighted ensemble — raw AUC\",\n",
    "        \"prob_ensemble_raw\"\n",
    "    ),\n",
    "    (\n",
    "        \"Primary weighted ensemble — calibrated AUC\",\n",
    "        \"prob_ensemble_calibrated\"\n",
    "    ),\n",
    "]:\n",
    "    result = cluster_bootstrap_auc(\n",
    "        master_oof,\n",
    "        col,\n",
    "        n_iterations=N_BOOTSTRAP,\n",
    "        seed=RANDOM_STATE + 900\n",
    "    )\n",
    "\n",
    "    bootstrap_rows.append({\n",
    "        \"metric\": label,\n",
    "        **result\n",
    "    })\n",
    "\n",
    "bootstrap_df = pd.DataFrame(\n",
    "    bootstrap_rows\n",
    ")\n",
    "\n",
    "bootstrap_df.to_csv(\n",
    "    TABLE_DIR\n",
    "    /\n",
    "    \"pregnancy_cluster_bootstrap_auc.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "display(\n",
    "    bootstrap_df\n",
    ")\n"
   ]
  },
