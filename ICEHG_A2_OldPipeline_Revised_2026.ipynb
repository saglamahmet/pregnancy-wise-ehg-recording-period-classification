    "            ).iloc[0].to_dict()\n",
    "        )\n",
    "\n",
    "        all_fold_metric_rows.append(\n",
    "            pd.read_csv(\n",
    "                metric_path\n",
    "            ).iloc[0].to_dict()\n",
    "        )\n",
    "\n",
    "        continue\n",
    "\n",
    "    outer_train_df = record_df.iloc[\n",
    "        outer_train_record_idx\n",
    "    ].copy()\n",
    "\n",
    "    outer_test_df = record_df.iloc[\n",
    "        outer_test_record_idx\n",
    "    ].copy()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # INNER OOF — dört representation\n",
    "    # --------------------------------------------------------\n",
    "    inner_cv = GroupKFold(\n",
    "        n_splits=N_INNER_SPLITS\n",
    "    )\n",
    "\n",
    "    inner_splits = list(\n",
    "        inner_cv.split(\n",
    "            outer_train_df,\n",
    "            outer_train_df[\n",
    "                \"label_num\"\n",
    "            ].astype(int).values,\n",
    "            outer_train_df[\n",
    "                \"pregnancy_id\"\n",
    "            ].astype(str).values\n",
    "        )\n",
    "    )\n",
    "\n",
    "    inner_rep_record_parts = {\n",
    "        rep: []\n",
    "        for rep in REPRESENTATIONS\n",
    "    }\n",
    "\n",
    "    for inner_fold, (\n",
    "        inner_train_local,\n",
    "        inner_val_local\n",
    "    ) in enumerate(\n",
    "        inner_splits,\n",
    "        start=1\n",
    "    ):\n",
    "        print(\n",
    "            \"\\n\"\n",
    "            +\n",
    "            \"-\" * 80\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"INNER FOLD {inner_fold}/3\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"-\" * 80\n",
    "        )\n",
    "\n",
    "        inner_train_record_idx = (\n",
    "            outer_train_record_idx[\n",
    "                inner_train_local\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        inner_val_record_idx = (\n",
    "            outer_train_record_idx[\n",
    "                inner_val_local\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        inner_train_seg = (\n",
    "            record_indices_to_segment_indices(\n",
    "                inner_train_record_idx\n",
    "            )\n",
    "        )\n",
    "\n",
    "        inner_val_seg = (\n",
    "            record_indices_to_segment_indices(\n",
    "                inner_val_record_idx\n",
    "            )\n",
    "        )\n",
    "\n",
    "        for rep in REPRESENTATIONS:\n",
    "            run_name = (\n",
    "                f\"outer{outer_fold}_\"\n",
    "                f\"inner{inner_fold}\"\n",
    "            )\n",
    "\n",
    "            seg_pred = (\n",
    "                train_predict_representation(\n",
    "                    representation=rep,\n",
    "                    train_segment_indices=inner_train_seg,\n",
    "                    validation_segment_indices=inner_val_seg,\n",
    "                    test_segment_indices=inner_val_seg,\n",
    "                    run_name=run_name,\n",
    "                    save_final_model=False,\n",
    "                )\n",
    "            )\n",
    "\n",
    "            rec_pred = (\n",
    "                aggregate_segment_predictions(\n",
    "                    seg_pred\n",
    "                )\n",
    "            )\n",
    "\n",
    "            rec_pred[\n",
    "                \"inner_fold\"\n",
    "            ] = inner_fold\n",
    "\n",
    "            inner_rep_record_parts[\n",
    "                rep\n",
    "            ].append(\n",
    "                rec_pred\n",
    "            )\n",
    "\n",
    "    inner_pred_dict = {\n",
    "        rep:\n",
    "        pd.concat(\n",
    "            inner_rep_record_parts[rep],\n",
    "            ignore_index=True\n",
    "        )\n",
    "        for rep in REPRESENTATIONS\n",
    "    }\n",
    "\n",
    "    # Her outer-training record tam bir kez inner OOF'ta olmalı.\n",
    "    expected_inner_records = set(\n",
    "        outer_train_df[\n",
    "            \"record_name\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    for rep in REPRESENTATIONS:\n",
    "        obtained = set(\n",
    "            inner_pred_dict[\n",
    "                rep\n",
    "            ][\n",
    "                \"record_name\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        if obtained != expected_inner_records:\n",
    "            raise RuntimeError(\n",
    "                f\"{rep}/outer{outer_fold}: \"\n",
    "                \"inner OOF kapsamı hatalı.\"\n",
    "            )\n",
    "\n",
    "        if inner_pred_dict[\n",
    "            rep\n",
    "        ][\n",
    "            \"record_name\"\n",
    "        ].duplicated().any():\n",
    "            raise RuntimeError(\n",
    "                f\"{rep}/outer{outer_fold}: \"\n",
    "                \"duplicate inner OOF records.\"\n",
    "            )\n",
    "\n",
    "        inner_pred_dict[\n",
    "            rep\n",
    "        ].to_csv(\n",
    "            fold_dir\n",
    "            /\n",
    "            f\"inner_oof_{rep}.csv\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "    inner_merged = (\n",
    "        merge_rep_record_predictions(\n",
    "            inner_pred_dict\n",
    "        )\n",
    "    )\n",
    "\n",
    "    inner_merged.to_csv(\n",
    "        fold_dir\n",
    "        /\n",
    "        \"inner_oof_all_representations.csv\",\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Ensemble config — SADECE inner OOF\n",
    "    # --------------------------------------------------------\n",
    "    (\n",
    "        selected,\n",
    "        selected_calibrator,\n",
    "        raw_weight_search,\n",
    "        calibrated_candidates,\n",
    "        threshold_search\n",
    "    ) = select_a2_corrected_configuration(\n",
    "        inner_merged\n",
    "    )\n",
    "\n",
    "    selected_weights = selected[\n",
    "        [\n",
    "            \"w_RGB\",\n",
    "            \"w_S1\",\n",
    "            \"w_S2\",\n",
    "            \"w_S3\"\n",
    "        ]\n",
    "    ].to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    selected_threshold = float(\n",
    "        selected[\n",
    "            \"threshold\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nSelected weights:\",\n",
    "        selected_weights\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Platt slope:\",\n",
    "        float(\n",
    "            selected[\n",
    "                \"platt_slope\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Threshold:\",\n",
    "        selected_threshold\n",
    "    )\n",
    "\n",
    "    raw_weight_search.to_csv(\n",
    "        fold_dir\n",
    "        /\n",
    "        \"weight_search_raw.csv\",\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    calibrated_candidates.to_csv(\n",
    "        fold_dir\n",
    "        /\n",
    "        \"weight_search_calibrated_candidates.csv\",\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    threshold_search.to_csv(\n",
    "        fold_dir\n",
    "        /\n",
    "        \"threshold_search.csv\",\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # FINAL MODEL — A2 deterministic validation split\n",
    "    # --------------------------------------------------------\n",
    "    final_validation_splitter = GroupKFold(\n",
    "        n_splits=N_INNER_SPLITS\n",
    "    )\n",
    "\n",
    "    (\n",
    "        final_train_local,\n",
    "        final_val_local\n",
    "    ) = next(\n",
    "        final_validation_splitter.split(\n",
    "            outer_train_df,\n",
    "            outer_train_df[\n",
    "                \"label_num\"\n",
    "            ].astype(int).values,\n",
    "            outer_train_df[\n",
    "                \"pregnancy_id\"\n",
    "            ].astype(str).values\n",
    "        )\n",
    "    )\n",
    "\n",
    "    final_train_record_idx = (\n",
    "        outer_train_record_idx[\n",
    "            final_train_local\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    final_val_record_idx = (\n",
    "        outer_train_record_idx[\n",
    "            final_val_local\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    final_train_df = record_df.iloc[\n",
    "        final_train_record_idx\n",
    "    ]\n",
    "\n",
    "    final_val_df = record_df.iloc[\n",
    "        final_val_record_idx\n",
    "    ]\n",
    "\n",
    "    validate_partition(\n",
    "        final_train_df,\n",
    "        final_val_df,\n",
    "        f\"Outer {outer_fold} final train/validation\"\n",
    "    )\n",
    "\n",
    "    final_train_seg = (\n",
    "        record_indices_to_segment_indices(\n",
    "            final_train_record_idx\n",
    "        )\n",
    "    )\n",
    "\n",
    "    final_val_seg = (\n",
    "        record_indices_to_segment_indices(\n",
    "            final_val_record_idx\n",
    "        )\n",
    "    )\n",
    "\n",
    "    outer_test_seg = (\n",
    "        record_indices_to_segment_indices(\n",
    "            outer_test_record_idx\n",
    "        )\n",
    "    )\n",
    "\n",
    "    outer_rep_dict = {}\n",
    "\n",
    "    for rep in REPRESENTATIONS:\n",
    "        run_name = (\n",
    "            f\"outer{outer_fold}_final\"\n",
    "        )\n",
    "\n",
    "        seg_pred = (\n",
    "            train_predict_representation(\n",
    "                representation=rep,\n",
    "                train_segment_indices=final_train_seg,\n",
    "                validation_segment_indices=final_val_seg,\n",
    "                test_segment_indices=outer_test_seg,\n",
    "                run_name=run_name,\n",
    "                save_final_model=True,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        rec_pred = (\n",
    "            aggregate_segment_predictions(\n",
    "                seg_pred\n",
    "            )\n",
    "        )\n",
    "\n",
    "        outer_rep_dict[\n",
    "            rep\n",
    "        ] = rec_pred\n",
    "\n",
    "        rec_pred.to_csv(\n",
    "            fold_dir\n",
    "            /\n",
    "            f\"outer_test_{rep}_record_predictions.csv\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "    outer_merged = (\n",
    "        merge_rep_record_predictions(\n",
    "            outer_rep_dict\n",
    "        )\n",
    "    )\n",
    "\n",
    "    outer_matrix = outer_merged[\n",
    "        [\n",
    "            \"prob_RGB\",\n",
    "            \"prob_S1\",\n",
    "            \"prob_S2\",\n",
    "            \"prob_S3\"\n",
    "        ]\n",
    "    ].astype(float).to_numpy()\n",
    "\n",
    "    raw_ensemble = (\n",
    "        outer_matrix\n",
    "        @\n",
    "        selected_weights\n",
    "    )\n",
    "\n",
    "    calibrated_ensemble = (\n",
    "        apply_platt(\n",
    "            selected_calibrator,\n",
    "            raw_ensemble\n",
    "        )\n",
    "    )\n",
    "\n",
    "    y_outer = outer_merged[\n",
    "        \"label_num\"\n",
    "    ].astype(int).to_numpy()\n",
    "\n",
    "    y_pred = (\n",
    "        calibrated_ensemble\n",
    "        >=\n",
    "        selected_threshold\n",
    "    ).astype(int)\n",
    "\n",
    "    outer_result = outer_merged.copy()\n",
    "\n",
    "    outer_result[\n",
    "        \"prob_ensemble_raw\"\n",
    "    ] = raw_ensemble\n",
    "\n",
    "    outer_result[\n",
    "        \"prob_ensemble_calibrated\"\n",
    "    ] = calibrated_ensemble\n",
    "\n",
    "    outer_result[\n",
    "        \"pred_label_num\"\n",
    "    ] = y_pred\n",
    "\n",
    "    outer_result[\n",
    "        \"outer_fold\"\n",
    "    ] = outer_fold\n",
    "\n",
    "    outer_result[\n",
    "        \"threshold\"\n",
    "    ] = selected_threshold\n",
    "\n",
    "    outer_result[\n",
    "        \"platt_slope\"\n",
    "    ] = float(\n",
    "        selected[\n",
    "            \"platt_slope\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    outer_result[\n",
    "        \"platt_intercept\"\n",
    "    ] = float(\n",
    "        selected[\n",
    "            \"platt_intercept\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    for rep, weight in zip(\n",
    "        REPRESENTATIONS,\n",
    "        selected_weights\n",
    "    ):\n",
    "        outer_result[\n",
    "            f\"w_{rep}\"\n",
    "        ] = float(\n",
    "            weight\n",
    "        )\n",
    "\n",
    "    outer_metrics = (\n",
    "        calculate_binary_metrics(\n",
    "            y_outer,\n",
    "            calibrated_ensemble,\n",
    "            y_pred\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # raw fold AUC ayrı saklanır.\n",
    "    outer_metrics[\n",
    "        \"raw_auc\"\n",
    "    ] = roc_auc_score(\n",
    "        y_outer,\n",
    "        raw_ensemble\n",
    "    )\n",
    "\n",
    "    outer_metrics[\n",
    "        \"calibrated_auc\"\n",
    "    ] = roc_auc_score(\n",
    "        y_outer,\n",
    "        calibrated_ensemble\n",
    "    )\n",
    "\n",
    "    config_row = {\n",
    "        \"outer_fold\": outer_fold,\n",
    "        \"w_RGB\": selected_weights[0],\n",
    "        \"w_S1\": selected_weights[1],\n",
    "        \"w_S2\": selected_weights[2],\n",
    "        \"w_S3\": selected_weights[3],\n",
    "        \"threshold\": selected_threshold,\n",
    "        \"platt_slope\": float(\n",
    "            selected[\n",
    "                \"platt_slope\"\n",
    "            ]\n",
    "        ),\n",
    "        \"platt_intercept\": float(\n",
    "            selected[\n",
    "                \"platt_intercept\"\n",
    "            ]\n",
    "        ),\n",
    "        \"inner_balanced_accuracy\": float(\n",
    "            selected[\n",
    "                \"inner_balanced_accuracy\"\n",
    "            ]\n",
    "        ),\n",
    "        \"inner_auc\": float(\n",
    "            selected[\n",
    "                \"inner_auc\"\n",
    "            ]\n",
    "        ),\n",
    "        \"n_inner_records\": len(\n",
    "            inner_merged\n",
    "        ),\n",
    "        \"n_inner_pregnancies\": inner_merged[\n",
    "            \"pregnancy_id\"\n",
    "        ].nunique(),\n",
    "    }\n",
    "\n",
    "    fold_metric_row = {\n",
    "        \"outer_fold\": outer_fold,\n",
    "        **outer_metrics,\n",
    "        \"threshold\": selected_threshold,\n",
    "        \"platt_slope\": config_row[\n",
    "            \"platt_slope\"\n",
    "        ],\n",
    "        \"platt_intercept\": config_row[\n",
    "            \"platt_intercept\"\n",
    "        ],\n",
    "        \"n_test_records\": len(\n",
    "            outer_result\n",
    "        ),\n",
    "        \"n_test_pregnancies\": outer_result[\n",
    "            \"pregnancy_id\"\n",
    "        ].nunique(),\n",
    "    }\n",
    "\n",
    "    outer_result.to_csv(\n",
    "        final_fold_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    pd.DataFrame(\n",
    "        [config_row]\n",
    "    ).to_csv(\n",
    "        config_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    pd.DataFrame(\n",
    "        [fold_metric_row]\n",
    "    ).to_csv(\n",
    "        metric_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    all_outer_parts.append(\n",
    "        outer_result\n",
    "    )\n",
    "\n",
    "    all_config_rows.append(\n",
    "        config_row\n",
    "    )\n",
    "\n",
    "    all_fold_metric_rows.append(\n",
    "        fold_metric_row\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nOUTER raw/cal AUC:\",\n",
    "        round(\n",
    "            outer_metrics[\n",
    "                \"raw_auc\"\n",
    "            ],\n",
    "            4\n",
    "        ),\n",
    "        \"/\",\n",
    "        round(\n",
    "            outer_metrics[\n",
    "                \"calibrated_auc\"\n",
    "            ],\n",
    "            4\n",
    "        )\n",
    "    )\n",
    "\n",
    "    del selected_calibrator\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "master_oof = (\n",
    "    pd.concat(\n",
    "        all_outer_parts,\n",
    "        ignore_index=True\n",
    "    )\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"outer_fold\",\n",
    "            \"record_name\"\n",
    "        ]\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "selected_configs_df = pd.DataFrame(\n",
    "    all_config_rows\n",
    ").sort_values(\n",
    "    \"outer_fold\"\n",
    ")\n",
    "\n",
    "fold_metrics_df = pd.DataFrame(\n",
    "    all_fold_metric_rows\n",
    ").sort_values(\n",
    "    \"outer_fold\"\n",
    ")\n",
    "\n",
    "if len(master_oof) != 126:\n",
    "    raise RuntimeError(\n",
    "        f\"Master OOF 126 kayıt olmalı, bulunan {len(master_oof)}\"\n",
    "    )\n",
    "\n",
    "if master_oof[\n",
    "    \"record_name\"\n",
    "].duplicated().any():\n",
    "    raise RuntimeError(\n",
    "        \"Master OOF duplicate record içeriyor.\"\n",
    "    )\n",
    "\n",
    "if master_oof[\n",
    "    \"pregnancy_id\"\n",
    "].nunique() != 91:\n",
    "    raise RuntimeError(\n",
    "        \"Master OOF 91 pregnancy içermiyor.\"\n",
    "    )\n",
    "\n",
    "master_oof.to_csv(\n",
    "    PRED_DIR\n",
    "    /\n",
    "    \"master_oof_predictions.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "selected_configs_df.to_csv(\n",
    "    TABLE_DIR\n",
    "    /\n",
    "    \"selected_fold_configurations.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "fold_metrics_df.to_csv(\n",
    "    TABLE_DIR\n",
    "    /\n",
    "    \"fold_metrics.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nANA EĞİTİM TAMAMLANDI.\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    selected_configs_df\n",
    ")\n",
    "\n",
    "display(\n",
    "    fold_metrics_df\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cd2bbb22",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# ============================================================\n",
    "# CELL 11 — Pooled AUC ve temel sonuç tablosu\n",
    "# ============================================================\n",
    "\n",
    "y = master_oof[\n",
    "    \"label_num\"\n",
    "].astype(int).to_numpy()\n",
    "\n",
    "raw_primary = master_oof[\n",
    "    \"prob_ensemble_raw\"\n",
    "].astype(float).to_numpy()\n",
    "\n",
    "cal_primary = master_oof[\n",
    "    \"prob_ensemble_calibrated\"\n",
    "].astype(float).to_numpy()\n",
    "\n",
    "y_pred = master_oof[\n",
    "    \"pred_label_num\"\n",
    "].astype(int).to_numpy()\n",
    "\n",
    "primary_metrics = calculate_binary_metrics(\n",
    "    y,\n",
    "    cal_primary,\n",
    "    y_pred\n",
    ")\n",
    "\n",
    "primary_raw_auc = roc_auc_score(\n",
    "    y,\n",
    "    raw_primary\n",
    ")\n",
    "\n",
    "primary_cal_auc = roc_auc_score(\n",
    "    y,\n",
    "    cal_primary\n",
    ")\n",
    "\n",
    "# Representation/fusion pooled raw AUC\n",
    "rgb = master_oof[\"prob_RGB\"].to_numpy(float)\n",
    "s1 = master_oof[\"prob_S1\"].to_numpy(float)\n",
    "s2 = master_oof[\"prob_S2\"].to_numpy(float)\n",
    "s3 = master_oof[\"prob_S3\"].to_numpy(float)\n",
    "\n",
    "equal_123 = (\n",
    "    rgb + s1 + s2\n",
    ") / 3.0\n",
    "\n",
    "equal_all4 = (\n",
    "    rgb + s1 + s2 + s3\n",
    ") / 4.0\n",
    "\n",
    "auc_rows = [\n",
    "    {\n",
    "        \"model\": \"RGB\",\n",
    "        \"raw_pooled_auc\": roc_auc_score(y, rgb)\n",
    "    },\n",
    "    {\n",
    "        \"model\": \"S1\",\n",
    "        \"raw_pooled_auc\": roc_auc_score(y, s1)\n",
    "    },\n",
    "    {\n",
    "        \"model\": \"S2\",\n",
