   "source": [
    "\n",
    "# ============================================================\n",
    "# CELL 8 — Tek representation eğitim/prediction görevi + resume\n",
    "# ============================================================\n",
    "\n",
    "def train_predict_representation(\n",
    "    representation,\n",
    "    train_segment_indices,\n",
    "    validation_segment_indices,\n",
    "    test_segment_indices,\n",
    "    run_name,\n",
    "    save_final_model=False,\n",
    "):\n",
    "    rep_pred_dir = (\n",
    "        PRED_DIR / representation\n",
    "    )\n",
    "\n",
    "    rep_model_dir = (\n",
    "        MODEL_DIR / representation\n",
    "    )\n",
    "\n",
    "    rep_history_dir = (\n",
    "        OUT_DIR / \"histories\" / representation\n",
    "    )\n",
    "\n",
    "    for p in [\n",
    "        rep_pred_dir,\n",
    "        rep_model_dir,\n",
    "        rep_history_dir\n",
    "    ]:\n",
    "        p.mkdir(\n",
    "            parents=True,\n",
    "            exist_ok=True\n",
    "        )\n",
    "\n",
    "    prediction_path = (\n",
    "        rep_pred_dir\n",
    "        /\n",
    "        f\"{run_name}_segment_predictions.csv\"\n",
    "    )\n",
    "\n",
    "    history_path = (\n",
    "        rep_history_dir\n",
    "        /\n",
    "        f\"{run_name}_history.csv\"\n",
    "    )\n",
    "\n",
    "    model_path = (\n",
    "        rep_model_dir\n",
    "        /\n",
    "        f\"{run_name}_best.keras\"\n",
    "    )\n",
    "\n",
    "    if (\n",
    "        not FORCE_RETRAIN\n",
    "        and prediction_path.exists()\n",
    "        and (\n",
    "            (not save_final_model)\n",
    "            or model_path.exists()\n",
    "        )\n",
    "    ):\n",
    "        print(\n",
    "            \"Resume →\",\n",
    "            prediction_path\n",
    "        )\n",
    "\n",
    "        return pd.read_csv(\n",
    "            prediction_path\n",
    "        )\n",
    "\n",
    "    run_seed = set_run_seed(\n",
    "        f\"{representation}_{run_name}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"\\n{representation} | {run_name} | seed={run_seed}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Train/Val/Test segments:\",\n",
    "        len(train_segment_indices),\n",
    "        len(validation_segment_indices),\n",
    "        len(test_segment_indices)\n",
    "    )\n",
    "\n",
    "    K.clear_session()\n",
    "    gc.collect()\n",
    "\n",
    "    model = build_a2_cnn_transformer(\n",
    "        representation\n",
    "    )\n",
    "\n",
    "    train_gen = A2ScalogramSequence(\n",
    "        representation,\n",
    "        train_segment_indices,\n",
    "        labels_all,\n",
    "        BATCH_SIZE,\n",
    "        shuffle=True,\n",
    "    )\n",
    "\n",
    "    val_gen = A2ScalogramSequence(\n",
    "        representation,\n",
    "        validation_segment_indices,\n",
    "        labels_all,\n",
    "        BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "    )\n",
    "\n",
    "    test_gen = A2ScalogramSequence(\n",
    "        representation,\n",
    "        test_segment_indices,\n",
    "        labels_all,\n",
    "        BATCH_SIZE,\n",
    "        shuffle=False,\n",
    "    )\n",
    "\n",
    "    callbacks = [\n",
    "        keras.callbacks.EarlyStopping(\n",
    "            monitor=\"val_auc\",\n",
    "            mode=\"max\",\n",
    "            patience=PATIENCE,\n",
    "            restore_best_weights=True,\n",
    "            verbose=1\n",
    "        ),\n",
    "\n",
    "        keras.callbacks.ReduceLROnPlateau(\n",
    "            monitor=\"val_auc\",\n",
    "            mode=\"max\",\n",
    "            factor=0.5,\n",
    "            patience=2,\n",
    "            min_lr=1e-7,\n",
    "            verbose=1\n",
    "        ),\n",
    "\n",
    "        keras.callbacks.TerminateOnNaN()\n",
    "    ]\n",
    "\n",
    "    if save_final_model:\n",
    "        callbacks.append(\n",
    "            keras.callbacks.ModelCheckpoint(\n",
    "                filepath=model_path,\n",
    "                monitor=\"val_auc\",\n",
    "                mode=\"max\",\n",
    "                save_best_only=True,\n",
    "                save_weights_only=False,\n",
    "                verbose=1\n",
    "            )\n",
    "        )\n",
    "\n",
    "    history = model.fit(\n",
    "        train_gen,\n",
    "        validation_data=val_gen,\n",
    "        epochs=EPOCHS,\n",
    "        callbacks=callbacks,\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "    pd.DataFrame(\n",
    "        history.history\n",
    "    ).to_csv(\n",
    "        history_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    probabilities = model.predict(\n",
    "        test_gen,\n",
    "        verbose=1\n",
    "    ).reshape(-1)\n",
    "\n",
    "    metadata_lookup = (\n",
    "        segment_df\n",
    "        .set_index(\n",
    "            \"segment_index\"\n",
    "        )\n",
    "        .loc[\n",
    "            np.asarray(\n",
    "                test_segment_indices,\n",
    "                dtype=int\n",
    "            )\n",
    "        ]\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    pred = pd.DataFrame({\n",
    "        \"segment_index\": np.asarray(\n",
    "            test_segment_indices,\n",
    "            dtype=int\n",
    "        ),\n",
    "        \"record_name\": metadata_lookup[\n",
    "            \"record_name\"\n",
    "        ].astype(str).values,\n",
    "        \"pregnancy_id\": metadata_lookup[\n",
    "            \"pregnancy_id\"\n",
    "        ].astype(str).values,\n",
    "        \"label_text\": metadata_lookup[\n",
    "            \"label_text\"\n",
    "        ].astype(str).values,\n",
    "        \"label_num\": metadata_lookup[\n",
    "            \"label_num\"\n",
    "        ].astype(int).values,\n",
    "        \"prob_early_raw\": probabilities.astype(\n",
    "            float\n",
    "        ),\n",
    "    })\n",
    "\n",
    "    pred.to_csv(\n",
    "        prediction_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    del model\n",
    "    del train_gen\n",
    "    del val_gen\n",
    "    del test_gen\n",
    "    del history\n",
    "\n",
    "    K.clear_session()\n",
    "    gc.collect()\n",
    "\n",
    "    return pred\n"
   ]
  },
