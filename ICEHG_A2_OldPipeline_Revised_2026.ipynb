    "\n",
    "# ============================================================\n",
    "# CELL 9 — A2 corrected ensemble seçimi\n",
    "# Yalnız INNER OOF kullanılır.\n",
    "# ============================================================\n",
    "\n",
    "def select_a2_corrected_configuration(\n",
    "    inner_merged\n",
    "):\n",
    "    y_inner = inner_merged[\n",
    "        \"label_num\"\n",
    "    ].astype(int).to_numpy()\n",
    "\n",
    "    prob_matrix = inner_merged[\n",
    "        [\n",
    "            \"prob_RGB\",\n",
    "            \"prob_S1\",\n",
    "            \"prob_S2\",\n",
    "            \"prob_S3\"\n",
    "        ]\n",
    "    ].astype(float).to_numpy()\n",
    "\n",
    "    raw_rows = []\n",
    "\n",
    "    for weight_row in WEIGHT_GRID.itertuples(\n",
    "        index=False\n",
    "    ):\n",
    "        weights = np.asarray(\n",
    "            [\n",
    "                weight_row.w_RGB,\n",
    "                weight_row.w_S1,\n",
    "                weight_row.w_S2,\n",
    "                weight_row.w_S3,\n",
    "            ],\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        raw_prob = (\n",
    "            prob_matrix\n",
    "            @\n",
    "            weights\n",
    "        )\n",
    "\n",
    "        threshold_row, _ = (\n",
    "            select_robust_threshold(\n",
    "                y_inner,\n",
    "                raw_prob\n",
    "            )\n",
    "        )\n",
    "\n",
    "        raw_rows.append({\n",
    "            \"w_RGB\": weights[0],\n",
    "            \"w_S1\": weights[1],\n",
    "            \"w_S2\": weights[2],\n",
    "            \"w_S3\": weights[3],\n",
    "            \"weight_l2_from_equal\": (\n",
    "                weight_row.weight_l2_from_equal\n",
    "            ),\n",
    "            \"raw_threshold\": (\n",
    "                threshold_row[\"threshold\"]\n",
    "            ),\n",
    "            \"raw_balanced_accuracy\": (\n",
    "                threshold_row[\n",
    "                    \"balanced_accuracy\"\n",
    "                ]\n",
    "            ),\n",
    "            \"raw_auc\": threshold_row[\n",
    "                \"auc\"\n",
    "            ],\n",
    "            \"raw_class_balance_gap\": (\n",
    "                threshold_row[\n",
    "                    \"class_balance_gap\"\n",
    "                ]\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    raw_df = pd.DataFrame(\n",
    "        raw_rows\n",
    "    )\n",
    "\n",
    "    shortlist = (\n",
    "        raw_df\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"raw_balanced_accuracy\",\n",
    "                \"raw_auc\",\n",
    "                \"raw_class_balance_gap\",\n",
    "                \"weight_l2_from_equal\"\n",
    "            ],\n",
    "            ascending=[\n",
    "                False,\n",
    "                False,\n",
    "                True,\n",
    "                True\n",
    "            ]\n",
    "        )\n",
    "        .head(\n",
    "            TOP_WEIGHT_CANDIDATES\n",
    "        )\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    candidate_rows = []\n",
    "    calibrators = {}\n",
    "    threshold_tables = {}\n",
    "\n",
    "    for _, candidate in shortlist.iterrows():\n",
    "        weights = candidate[\n",
    "            [\n",
    "                \"w_RGB\",\n",
    "                \"w_S1\",\n",
    "                \"w_S2\",\n",
    "                \"w_S3\"\n",
    "            ]\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        raw_prob = (\n",
    "            prob_matrix\n",
    "            @\n",
    "            weights\n",
    "        )\n",
    "\n",
    "        calibrator, slope, intercept = (\n",
    "            fit_positive_platt(\n",
    "                y_inner,\n",
    "                raw_prob\n",
    "            )\n",
    "        )\n",
    "\n",
    "        # A2 corrected logic:\n",
    "        # negative/zero slope calibration kabul edilmez.\n",
    "        if calibrator is None:\n",
    "            continue\n",
    "\n",
    "        calibrated = apply_platt(\n",
    "            calibrator,\n",
    "            raw_prob\n",
    "        )\n",
    "\n",
    "        selected_threshold_row, threshold_df = (\n",
    "            select_robust_threshold(\n",
    "                y_inner,\n",
    "                calibrated\n",
    "            )\n",
    "        )\n",
    "\n",
    "        key = len(\n",
    "            candidate_rows\n",
    "        )\n",
    "\n",
    "        calibrators[\n",
    "            key\n",
    "        ] = calibrator\n",
    "\n",
    "        threshold_tables[\n",
    "            key\n",
    "        ] = threshold_df\n",
    "\n",
    "        candidate_rows.append({\n",
    "            \"candidate_key\": key,\n",
    "            \"w_RGB\": weights[0],\n",
    "            \"w_S1\": weights[1],\n",
    "            \"w_S2\": weights[2],\n",
    "            \"w_S3\": weights[3],\n",
    "            \"weight_l2_from_equal\": (\n",
    "                candidate[\n",
    "                    \"weight_l2_from_equal\"\n",
    "                ]\n",
    "            ),\n",
    "            \"platt_slope\": slope,\n",
    "            \"platt_intercept\": intercept,\n",
    "            \"threshold\": (\n",
    "                selected_threshold_row[\n",
    "                    \"threshold\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_accuracy\": (\n",
    "                selected_threshold_row[\n",
    "                    \"accuracy\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_precision\": (\n",
    "                selected_threshold_row[\n",
    "                    \"precision\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_sensitivity\": (\n",
    "                selected_threshold_row[\n",
    "                    \"sensitivity\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_specificity\": (\n",
    "                selected_threshold_row[\n",
    "                    \"specificity\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_f1\": (\n",
    "                selected_threshold_row[\n",
    "                    \"f1\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_balanced_accuracy\": (\n",
    "                selected_threshold_row[\n",
    "                    \"balanced_accuracy\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_auc\": (\n",
    "                selected_threshold_row[\n",
    "                    \"auc\"\n",
    "                ]\n",
    "            ),\n",
    "            \"inner_class_balance_gap\": (\n",
    "                selected_threshold_row[\n",
    "                    \"class_balance_gap\"\n",
    "                ]\n",
    "            ),\n",
    "            \"threshold_distance_to_half\": (\n",
    "                selected_threshold_row[\n",
    "                    \"distance_to_half\"\n",
    "                ]\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    candidate_df = pd.DataFrame(\n",
    "        candidate_rows\n",
    "    )\n",
    "\n",
    "    if candidate_df.empty:\n",
    "        raise RuntimeError(\n",
    "            \"Pozitif slope Platt candidate bulunamadı.\"\n",
    "        )\n",
    "\n",
    "    selected = (\n",
    "        candidate_df\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"inner_balanced_accuracy\",\n",
    "                \"inner_auc\",\n",
    "                \"inner_class_balance_gap\",\n",
    "                \"weight_l2_from_equal\",\n",
    "                \"threshold_distance_to_half\"\n",
    "            ],\n",
    "            ascending=[\n",
    "                False,\n",
    "                False,\n",
    "                True,\n",
    "                True,\n",
    "                True\n",
    "            ]\n",
    "        )\n",
    "        .iloc[0]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    key = int(\n",
    "        selected[\n",
    "            \"candidate_key\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        selected,\n",
    "        calibrators[key],\n",
    "        raw_df,\n",
    "        candidate_df,\n",
    "        threshold_tables[key]\n",
    "    )\n"
   ]
  },
